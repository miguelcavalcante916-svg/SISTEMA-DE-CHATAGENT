# Copie para .env e ajuste. Nenhum valor aqui é segredo real.

# Servidor local (painel + API). Mantenha 127.0.0.1 para acesso só no computador do balcão.
# Use 0.0.0.0 apenas se quiser acessar de um tablet na mesma rede (e proteja a rede).
HOST=127.0.0.1
PORT=3333

# Banco SQLite local (arquivo). A pasta é criada automaticamente.
DATABASE_PATH=./data/app.db

# Pasta de backups locais
BACKUP_DIR=./data/backups

# Nível de log: fatal | error | warn | info | debug
LOG_LEVEL=info

# Cookie de sessão só por HTTPS? Deixe false em uso local (http://127.0.0.1).
SESSION_COOKIE_SECURE=false

# Validade da sessão em horas
SESSION_TTL_HOURS=168

# Ollama local (opcional). O painel permite sobrescrever endereço e modelo.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TIMEOUT_MS=20000
AI_MAX_REPLY_CHARS=800

# Segredo HMAC para validar webhooks de canais de mensagem.
# Vazio = endpoint de webhook desabilitado. Gere com: openssl rand -hex 32
WEBHOOK_SECRET=

# Janela (segundos) aceita para o timestamp de um webhook (proteção contra repetição)
WEBHOOK_MAX_AGE_SECONDS=300

# ---- WhatsApp (não oficial, via open-wa) ----
# none   = sem WhatsApp (apenas simulador e atendimento manual)
# openwa = usa a ponte em integrations/whatsapp-openwa (processo separado)
WHATSAPP_PROVIDER=none

# Token que a ponte usa para falar com este servidor (fila de saída e heartbeat).
# Gere com: openssl rand -hex 32. Vazio = ponte desabilitada.
BRIDGE_TOKEN=

# Trava de segurança: só envia mensagens reais pelo WhatsApp quando true.
# Mantenha false em desenvolvimento/testes.
WHATSAPP_SEND_ENABLED=false
