# URL do servidor local do sistema (API)
SERVER_URL=http://127.0.0.1:3333

# Deve ser igual ao WEBHOOK_SECRET do servidor (assina as mensagens recebidas)
WEBHOOK_SECRET=

# Deve ser igual ao BRIDGE_TOKEN do servidor (fila de saída e heartbeat)
BRIDGE_TOKEN=

# Nome da sessão do WhatsApp (pasta de dados local). Um número por sessão.
SESSION_ID=atendimento

# Pasta onde o open-wa guarda a sessão (não compartilhe: contém credenciais do WhatsApp Web)
SESSION_DATA_PATH=./session-data

# true = sem janela do navegador. Para o primeiro pareamento pode ajudar deixar false.
HEADLESS=true

# Caminho do Chrome/Chromium instalado (opcional). Se vazio, o open-wa tenta baixar/encontrar um navegador.
CHROME_PATH=

# Argumentos extras do Chromium, separados por vírgula (ex.: --no-sandbox,--disable-gpu).
# Em Linux rodando como root, --no-sandbox é adicionado automaticamente.
CHROMIUM_ARGS=

# Chave de licença do open-wa (opcional; alguns recursos exigem). Deixe vazio para uso básico.
OPENWA_LICENSE_KEY=

# Intervalo (ms) de verificação da fila de saída e de heartbeat
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=30000

# Lista de números permitidos para ENVIO durante testes (separados por vírgula, só dígitos com DDI).
# Vazio = qualquer número (desde que WHATSAPP_SEND_ENABLED=true no servidor).
ALLOWED_RECIPIENTS=
